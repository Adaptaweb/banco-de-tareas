---
import { loadState } from '../lib/db';
import HamburgerMenu from '../components/HamburgerMenu.astro';
const db = loadState();
const tieneTareas = db.tareas_activas.length > 0;
const pageTitle = Astro.props.title || 'Banco de Tareas';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='%23fbd000'/%3E%3Ccircle cx='16' cy='16' r='12' fill='%231a1a2e'/%3E%3Cline x1='16' y1='16' x2='11' y2='8' stroke='%23ffffff' stroke-width='2.5' stroke-linecap='round'/%3E%3Cline x1='16' y1='16' x2='23' y2='12' stroke='%23ffffff' stroke-width='2' stroke-linecap='round'/%3E%3Ccircle cx='16' cy='16' r='1.5' fill='%23fbd000'/%3E%3Cpolyline points='7,18 13,24 25,10' fill='none' stroke='%2355ff55' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Press+Start+2P&family=Exo+2:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
  <title>{pageTitle}</title>
</head>
<body class="theme-minecraft">
  <div class="vault-bg">
    <div class="mario-scene">
      <div class="mario-cloud" style="--speed:25s;--top:8%;--scale:1"></div>
      <div class="mario-cloud" style="--speed:40s;--top:18%;--scale:0.7"></div>
      <div class="mario-cloud" style="--speed:50s;--top:5%;--scale:0.6"></div>
      <div class="mario-pipe" style="--height:120px;--left:12%"></div>
      <div class="mario-pipe" style="--height:80px;--left:75%"></div>
      <div class="mario-pipe" style="--height:160px;--left:55%"></div>
      <div class="mario-question-block"></div>
      <div class="mario-ground"></div>
    </div>
    <div class="mc-scene">
      <div class="mc-sun"></div>
      <div class="mc-cloud" style="--speed:45s;--top:12%;--scale:1"></div>
      <div class="mc-cloud" style="--speed:60s;--top:22%;--scale:0.8"></div>
      <div class="mc-cloud" style="--speed:55s;--top:6%;--scale:0.7"></div>
      <div class="mc-tree" style="--left:10%"></div>
      <div class="mc-tree" style="--left:82%"></div>
      <div class="mc-ground"></div>
    </div>
    <div class="fede-scene">
      <div class="fede-bolt" style="--left:15%;--delay:0s"></div>
      <div class="fede-bolt" style="--left:72%;--delay:1.3s"></div>
      <div class="fede-bolt" style="--left:45%;--delay:2.6s"></div>
      <div class="fede-spark" style="--left:20%;--delay:0.4s"></div>
      <div class="fede-spark" style="--left:58%;--delay:1.8s"></div>
      <div class="fede-spark" style="--left:80%;--delay:0.9s"></div>
      <div class="fede-spark" style="--left:35%;--delay:2.7s"></div>
      <div class="fede-spark" style="--left:90%;--delay:3.4s"></div>
    </div>

  </div>
  <HamburgerMenu />
  <slot />
  <script>
    const soundsMap = {
      minecraft: {
        click: '/sounds/minecraft/menuclick.mp3',
        coin: '/sounds/minecraft/moneda.mp3',
        error: '/sounds/minecraft/error.mp3',
        victory: '/sounds/minecraft/victory.mp3',
      },
      mario: {
        click: '/sounds/mario/mario_click.mp3',
        coin: '/sounds/mario/mario_coin.mp3',
        error: '/sounds/mario/mario_error.mp3',
        victory: '/sounds/mario/mario_victory.mp3',
      },
      fifa: {
        click: '/sounds/fifa/fifa_click.mp3',
        coin: '/sounds/fifa/fifa_goal.mp3',
        error: '/sounds/fifa/fifa_error.mp3',
        victory: '/sounds/fifa/fifa_victory.mp3',
      },
      fede: {
        click: '/sounds/minecraft/menuclick.mp3',
        coin: '/sounds/minecraft/moneda.mp3',
        error: '/sounds/minecraft/error.mp3',
        victory: '/sounds/minecraft/victory.mp3',
      },
    };

    const savedTheme = localStorage.getItem('temaBanco') || 'minecraft';

    function aplicarTema(tema) {
      document.body.className = '';
      if (tema === 'mario') document.body.classList.add('theme-mario');
      else if (tema === 'fifa') document.body.classList.add('theme-fifa');
      else if (tema === 'fede') document.body.classList.add('theme-fede');
      else document.body.classList.add('theme-minecraft');
      localStorage.setItem('temaBanco', tema);

      const sel = document.getElementById('themeSelect');
      if (sel) sel.value = tema;

      const aClic = document.getElementById('audioClic');
      const aMoneda = document.getElementById('audioMoneda');
      const aError = document.getElementById('audioError');
      const aVictory = document.getElementById('audioVictory');
      const aSobre = document.getElementById('audioSobre');
      if (aClic && soundsMap[tema]) {
        aClic.src = soundsMap[tema].click;
        aMoneda.src = soundsMap[tema].coin;
        aError.src = soundsMap[tema].error;
        aVictory.src = soundsMap[tema].victory;
        if (aSobre) aSobre.src = soundsMap[tema].victory;
        [aClic, aMoneda, aError, aVictory, aSobre].forEach(a => { if (a) a.load(); });
      }
    }

    aplicarTema(savedTheme);

    // Detección de capacidad del dispositivo
    const esLento = ('hardwareConcurrency' in navigator && navigator.hardwareConcurrency < 4)
                 || ('deviceMemory' in navigator && navigator.deviceMemory < 4);
    if (esLento) document.body.classList.add('slow-device');

    window.themeListo = true;

    window.cambiarTema = function(tema) {
      aplicarTema(tema);
      const aClic = document.getElementById('audioClic');
      if (aClic) { aClic.currentTime = 0; aClic.play().catch(() => {}); }
      document.dispatchEvent(new CustomEvent('temaCambiado', { detail: { tema } }));
    };
  </script>
</body>
</html>
