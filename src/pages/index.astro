---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeSelector from '../components/ThemeSelector.astro';
import Slideshow from '../components/Slideshow.astro';
import XpBar from '../components/XpBar.astro';
import TaskButton from '../components/TaskButton.astro';
import { loadState } from '../lib/db';
import { formatoTiempo } from '../lib/telegram';

const db = loadState();
const tareas = db.tareas_activas;
const total = tareas.length;
---

<BaseLayout title="Banco de Tareas — Matías">
  <ThemeSelector />
  <Slideshow />

  <div class="container">
    <div class="clock-display" id="reloj">
      <span class="clock-hourglass">⏳</span>
      <span class="clock-time">--:--:--</span>
    </div>

    <div class="card">
      <XpBar
        total_tareas={total}
        aprobadas={0}
        tiempo_formato={formatoTiempo(0)}
      />

      <div id="contenido" class="task-grid">
        {total > 0 ? (
          tareas.map((t, i) => (
            <TaskButton nombre={t.nombre} icono={t.icono} tiempo={t.tiempo} disabled={false} index={i} />
          ))
        ) : (
          <div class="empty-msg">
            <p>No hay misiones configuradas</p>
            <a href="/admin" class="btn">Ir al Panel</a>
          </div>
        )}
      </div>
    </div>
  </div>

  <audio id="audioClic" preload="auto" src="/sounds/minecraft/menuclick.mp3"></audio>
  <audio id="audioMoneda" preload="auto" src="/sounds/minecraft/moneda.mp3"></audio>
  <audio id="audioError" preload="auto" src="/sounds/minecraft/error.mp3"></audio>
  <audio id="audioVictory" preload="auto" src="/sounds/minecraft/victory.mp3"></audio>

  <script>
    let ultimoEstadoProcesado = 'esperando';
    let finalActivo = false;
    const aClic = document.getElementById('audioClic');
    const aMoneda = document.getElementById('audioMoneda');
    const aError = document.getElementById('audioError');
    const aVictory = document.getElementById('audioVictory');
    window.sonarHover = function() { aClic.currentTime = 0; aClic.play().catch(() => {}); }
    function habilitarAudio() {
      [aClic, aMoneda, aError, aVictory].forEach(a => {
        a.muted = true; a.play().then(() => { a.pause(); a.currentTime = 0; a.muted = false; }).catch(() => {});
      });
      document.removeEventListener('click', habilitarAudio);
      document.removeEventListener('touchstart', habilitarAudio);
    }
    document.addEventListener('click', habilitarAudio);
    document.addEventListener('touchstart', habilitarAudio);
    function spawnConfetti() {
      const emojis = ['🎆', '✨', '💎', '⭐', '🎇'];
      const el = document.createElement('div');
      el.className = 'confetti';
      el.innerText = emojis[Math.floor(Math.random() * emojis.length)];
      el.style.cssText = 'position:fixed;font-size:25px;z-index:1;pointer-events:none;left:' + (Math.random()*100) + 'vw;top:-5vh;animation:confetti-fall 3s linear forwards;';
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 3000);
    }
    function actualizarReloj() {
      const ahora = new Date();
      const fechaStr = ahora.toLocaleDateString('es-CL', { weekday: 'long', day: 'numeric', month: 'long' });
      const horaStr = ahora.toLocaleTimeString('es-CL', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
      const parpadeo = ahora.getSeconds() % 2 === 0 ? '1' : '0.5';
      document.getElementById('reloj').innerHTML = fechaStr.toUpperCase() + ' <span style="opacity:' + parpadeo + ';">⏳</span> ' + horaStr;
      const ssTime = document.getElementById('slideshow-time');
      const ssDate = document.getElementById('slideshow-date');
      if (ssTime && ssDate) { ssTime.innerText = horaStr; ssDate.innerText = fechaStr.toUpperCase(); }
    }
    setInterval(actualizarReloj, 1000);
    window.enviarMision = function(tarea) {
      aClic.currentTime = 0; aClic.play().catch(() => {});
      document.body.classList.remove('fail-mode');
      document.getElementById('contenido').innerHTML = "<div class='status waiting-status'><div class='spinner'></div><p>Solicitando Aprobación</p></div>";
      ultimoEstadoProcesado = 'enviada';
      fetch('/api/mandar?tarea=' + encodeURIComponent(tarea));
    }
    window.volverAlMenu = function() { fetch('/api/estado-reset').then(() => { location.reload(); }); }
    function pollEstado() {
      fetch('/api/estado').then(res => res.json()).then(data => {
        let porcentaje = data.total_tareas > 0 ? Math.round((data.aprobadas.length / data.total_tareas) * 100) : 0;
        document.getElementById('xpFill').style.width = Math.min(porcentaje, 100) + '%';
        document.getElementById('porcentajeTxt').innerText = porcentaje + '%';
        document.getElementById('faltaPorcentajeTxt').innerText = 'Faltan ' + (100 - porcentaje > 0 ? 100 - porcentaje : 0) + '%';
        document.getElementById('tiempoTxt').innerText = data.tiempo_formato;
        document.getElementById('tareasTxt').innerText = 'MISIONES: ' + data.aprobadas.length + ' / ' + data.total_tareas;
        const contenido = document.getElementById('contenido');
        if (!contenido) return;
        if (data.total_tareas > 0 && data.aprobadas.length === data.total_tareas) {
          if (!finalActivo) {
            finalActivo = true; aVictory.play();
            document.body.classList.add('victory-mode');
            contenido.innerHTML = "<div class='status' style='padding:24px;text-align:center;border:2px solid var(--color-gold);border-radius:var(--radius);background:var(--color-surface);'><h2 style='color:var(--color-gold);font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;'>META FINAL!</h2><p style='color:var(--color-emerald);font-size:1.2rem;font-weight:600;'>" + data.total_tareas + "/" + data.total_tareas + " MISIONES LOGRADAS</p></div>";
            setInterval(spawnConfetti, 300);
          }
        } else {
          data.aprobadas.forEach(tarea => {
            const btn = document.querySelector('[data-nombre="' + tarea + '"]');
            if (btn && !btn.disabled) btn.disabled = true;
          });
          if (data.valor === 'aprobada' && ultimoEstadoProcesado !== 'aprobada') {
            ultimoEstadoProcesado = 'aprobada'; aMoneda.play();
            document.body.classList.remove('fail-mode');
            contenido.innerHTML = "<div style='display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;height:100%;grid-column:1/-1;'><div class='status' style='padding:24px;text-align:center;border:2px solid var(--color-emerald);border-radius:var(--radius);background:var(--color-surface);width:100%;'><p style='color:var(--color-emerald);font-size:1.3rem;font-weight:700;font-family:var(--font-display);'>LEVEL UP!</p><p style='color:var(--color-text);margin-top:8px;'>Misión cumplida</p></div><button onclick='volverAlMenu()' class='btn' style='width:auto;min-width:200px;'><span class='btn-icon'>🔄</span> VOLVER</button></div>";
          } else if (data.valor === 'rechazada' && ultimoEstadoProcesado !== 'rechazada') {
            ultimoEstadoProcesado = 'rechazada'; aError.play();
            document.body.classList.add('fail-mode');
            contenido.innerHTML = "<div style='display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;height:100%;grid-column:1/-1;'><div class='status' style='padding:24px;text-align:center;border:2px solid var(--color-rose);border-radius:var(--radius);background:rgba(244,63,94,0.1);width:100%;'><p style='color:var(--color-rose);font-size:1.1rem;font-family:var(--font-display);'>RECHAZADO</p></div><button onclick='volverAlMenu()' class='btn' style='width:auto;min-width:200px;'><span class='btn-icon'>🏹</span> REINTENTAR</button></div>";
          }
        }
        setTimeout(pollEstado, 1500);
      }).catch(() => { setTimeout(pollEstado, 3000); });
    }
    pollEstado();
    let timeoutInactivity, slideshowInterval;
    const TIME_INACTIVITY = 60000;
    let isSlideshowActive = false, imagesList = [], currentImageIndex = 0;
    function resetInactivityTimer() {
      if (isSlideshowActive) hideSlideshow();
      clearTimeout(timeoutInactivity);
      timeoutInactivity = setTimeout(startSlideshow, TIME_INACTIVITY);
    }
    function hideSlideshow() {
      isSlideshowActive = false;
      const c = document.getElementById('slideshow-container');
      c.classList.remove('active');
      setTimeout(() => { if (!isSlideshowActive) c.style.display = 'none'; }, 1000);
      clearInterval(slideshowInterval);
    }
    function startSlideshow() {
      fetch('/api/slideshow-images').then(res => res.json()).then(data => {
        if (data.images && data.images.length > 0) {
          imagesList = data.images; currentImageIndex = 0;
          document.getElementById('slideshow-img').src = imagesList[0];
          const c = document.getElementById('slideshow-container');
          c.style.display = 'block'; void c.offsetWidth; c.classList.add('active');
          isSlideshowActive = true;
          slideshowInterval = setInterval(() => {
            const img = document.getElementById('slideshow-img');
            img.classList.add('fade-out');
            setTimeout(() => {
              currentImageIndex = (currentImageIndex + 1) % imagesList.length;
              img.src = imagesList[currentImageIndex]; img.classList.remove('fade-out');
            }, 1500);
          }, 60000);
        }
      }).catch(() => {});
    }
    ['mousemove','mousedown','keypress','touchstart','scroll'].forEach(e => {
      document.addEventListener(e, resetInactivityTimer, true);
    });
    resetInactivityTimer();
  </script>

  <style>
    .clock-display {
      font-family: var(--font-display);
      font-size: clamp(19px, 2dvh, 20px);
      color: var(--primary);
      text-align: center;
      margin-bottom: clamp(6px, 1dvh, 16px);
      letter-spacing: 1px;
      text-shadow: 0 0 20px rgba(251, 191, 36, 0.1);
    }
    .status {
      animation: fadeIn 0.4s ease forwards;
      padding: clamp(14px, 3dvh, 32px) !important;
    }
    .status h2 {
      font-size: clamp(19px, 2.5dvh, 26px) !important;
    }
    .status p {
      font-size: clamp(19px, 2.2dvh, 24px) !important;
    }
    .confetti {
      position: fixed;
      font-size: clamp(16px, 3dvh, 28px);
      z-index: 100;
      pointer-events: none;
      filter: drop-shadow(0 0 6px rgba(251, 191, 36, 0.5));
      will-change: transform;
    }
    @keyframes confetti-fall {
      0% { transform: translateY(0) rotate(0deg) scale(1); opacity: 1; }
      100% { transform: translateY(110vh) rotate(720deg) scale(0.3); opacity: 0; }
    }
    .task-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(4px, 0.6dvh, 8px);
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      align-content: start;
    }
    .empty-msg {
      text-align: center;
      padding: clamp(16px, 3dvh, 40px) clamp(16px, 3vw, 28px);
      color: var(--color-text-dim);
      font-family: var(--font-body);
      font-size: clamp(14px, 1.8dvh, 18px);
    }
    .empty-msg .btn {
      display: inline-flex;
      width: auto;
      margin-top: clamp(10px, 1.5dvh, 20px);
      font-size: clamp(13px, 1.6dvh, 18px);
      padding: clamp(10px, 1.5dvh, 16px) clamp(18px, 2.5dvh, 28px);
    }
    body.fail-mode .card {
      border-color: var(--color-rose);
      box-shadow: 0 0 30px rgba(244, 63, 94, 0.2);
    }
    body.fail-mode .card::after {
      background: linear-gradient(90deg, transparent, var(--color-rose), transparent);
    }
    body.victory-mode .card {
      border-color: var(--color-gold);
      box-shadow: 0 0 40px rgba(251, 191, 36, 0.3);
    }
    body.victory-mode .card::after {
      background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
    }

    .waiting-status {
      padding: 24px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
    .waiting-status p {
      font-family: var(--font-display);
      font-size: 1.1rem;
    }
    .spinner {
      width: 36px;
      height: 36px;
      border: 4px solid var(--color-gold-dim);
      border-top-color: var(--color-gold);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</BaseLayout>
