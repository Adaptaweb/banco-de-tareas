---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeSelector from '../components/ThemeSelector.astro';
import Slideshow from '../components/Slideshow.astro';
import XpBar from '../components/XpBar.astro';
import TaskButton from '../components/TaskButton.astro';
import { loadState } from '../lib/db';
import { formatoTiempo } from '../lib/telegram';

const db = loadState();
const tareas = db.tareas_activas;
const total = tareas.length;
---

<BaseLayout title="Banco de Tareas — Matías">
  <ThemeSelector />
  <Slideshow />

  <div class="container">
    <div class="clock-display" id="reloj">
      <span class="clock-hourglass">⏳</span>
      <span class="clock-time">--:--:--</span>
    </div>

    <div class="card">
      <XpBar
        total_tareas={total}
        aprobadas={0}
        tiempo_formato={formatoTiempo(0)}
      />

      <div id="contenido" class="task-grid">
        {total > 0 ? (
          tareas.map((t, i) => (
            <TaskButton nombre={t.nombre} icono={t.icono} tiempo={t.tiempo} disabled={false} index={i} />
          ))
        ) : (
          <div class="empty-msg">
            <p>No hay misiones configuradas</p>
            <a href="/admin" class="btn">Ir al Panel</a>
          </div>
        )}
      </div>
    </div>
  </div>

  <audio id="audioClic" preload="none"></audio>
  <audio id="audioMoneda" preload="none"></audio>
  <audio id="audioError" preload="none"></audio>
  <audio id="audioVictory" preload="none"></audio>
  <audio id="audioSobre" preload="none"></audio>

  <script>
    let ultimoEstadoProcesado = 'esperando';
    let finalActivo = false;
    let sobreAnimando = false;
    const aClic = document.getElementById('audioClic');
    const aMoneda = document.getElementById('audioMoneda');
    const aError = document.getElementById('audioError');
    const aVictory = document.getElementById('audioVictory');
    const aSobre = document.getElementById('audioSobre');
    window.sonarHover = function() { aClic.currentTime = 0; aClic.play().catch(() => {}); }
    function habilitarAudio() {
      [aClic, aMoneda, aError, aVictory, aSobre].forEach(a => {
        a.muted = true; a.play().then(() => { a.pause(); a.currentTime = 0; a.muted = false; }).catch(() => {});
      });
      document.removeEventListener('click', habilitarAudio);
      document.removeEventListener('touchstart', habilitarAudio);
    }
    document.addEventListener('click', habilitarAudio);
    document.addEventListener('touchstart', habilitarAudio);
    function spawnConfetti() {
      const colors = ['#ff0','#f0f','#0ff','#f00','#0f0','#00f','#ff8800','#ff4488','#fff'];
      for (let i = 0; i < 5; i++) {
        const el = document.createElement('div');
        const color = colors[Math.floor(Math.random() * colors.length)];
        const size = 5 + Math.random() * 8;
        const left = Math.random() * 100;
        const dur = 2 + Math.random() * 2;
        const rot = Math.random() * 720;
        const shape = Math.random() > 0.5 ? '50%' : '0';
        el.style.cssText = `position:fixed;width:${size}px;height:${size}px;background:${color};border-radius:${shape};left:${left}vw;top:-10px;z-index:100;pointer-events:none;will-change:transform,opacity;animation:confetti-fall ${dur}s linear forwards;transform:rotate(${rot}deg);`;
        document.body.appendChild(el);
        setTimeout(() => el.remove(), dur * 1000);
      }
    }
    function spawnFirework() {
      const cx = 10 + Math.random() * 80;
      const cy = 10 + Math.random() * 40;
      const colors = ['#ff0','#f44','#4f4','#44f','#f4f','#4ff','#ff8800','#fff'];
      const color = colors[Math.floor(Math.random() * colors.length)];
      const count = 25 + Math.floor(Math.random() * 20);
      for (let i = 0; i < count; i++) {
        const el = document.createElement('div');
        const angle = (i / count) * Math.PI * 2;
        const dist = 60 + Math.random() * 100;
        const dx = Math.cos(angle) * dist;
        const dy = Math.sin(angle) * dist;
        const size = 3 + Math.random() * 4;
        el.style.cssText = `position:fixed;width:${size}px;height:${size}px;background:${color};border-radius:50%;left:${cx}vw;top:${cy}vh;z-index:100;pointer-events:none;will-change:transform,opacity;--dx:${dx}px;--dy:${dy}px;animation:firework-burst 1.2s ease-out forwards;`;
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 1200);
      }
    }
    function mostrarSobreMundial(despues) {
      if (sobreAnimando) return;
      sobreAnimando = true;
      detenerPoll();

      const sobre = document.createElement('div');
      sobre.id = 'sobre-overlay';
      sobre.innerHTML = '<div id="sobre-bg"></div>'
        + '<div id="sobre-brillo"></div>'
        + '<div id="sobre-contenedor">'
        + '<div id="sobre-imagen"></div>'
        + '</div>'
        + '<div id="sobre-mensaje"><h2>⚽ ¡MISIÓN CUMPLIDA! ⚽</h2><p>Has ganado un sobre del Mundial</p></div>'
        + '<div id="sobre-tap-texto">Toca la pantalla para guardar tu sobre</div>'
        + '<div id="sobre-coleccion"></div>'
        + '<div id="sobre-guardado">🎉 ¡Guardado!</div>';
      document.body.appendChild(sobre);

      const contenedor = document.getElementById('sobre-contenedor');
      const brillo = document.getElementById('sobre-brillo');
      const imagen = document.getElementById('sobre-imagen');
      const mensaje = document.getElementById('sobre-mensaje');
      const tapTexto = document.getElementById('sobre-tap-texto');
      const coleccion = document.getElementById('sobre-coleccion');
      const guardado = document.getElementById('sobre-guardado');
      let animandoGuardar = false;

      void sobre.offsetWidth;
      sobre.classList.add('active');

      setTimeout(() => {
        contenedor.classList.add('entrada');
        aVictory.currentTime = 0; aVictory.play().catch(() => {});
      }, 100);

      setTimeout(() => {
        mensaje.classList.add('show');
        tapTexto.classList.add('show');
      }, 900);

      function guardarSobre() {
        if (animandoGuardar) return;
        animandoGuardar = true;
        tapTexto.classList.remove('show');
        mensaje.classList.remove('show');
        contenedor.classList.add('guardar');
        brillo.classList.add('expand');

        for (let i = 0; i < 20; i++) {
          const p = document.createElement('div');
          p.className = 'sobre-coleccion-particula';
          const size = 4 + Math.random() * 8;
          const colors = ['#ffd700','#ff6b6b','#51cf66','#339af0','#fcc419','#fff'];
          const color = colors[Math.floor(Math.random() * colors.length)];
          const angle = (i / 20) * Math.PI * 2 + (Math.random() - 0.5) * 0.8;
          const dist = 60 + Math.random() * 120;
          const dx = Math.cos(angle) * dist;
          const dy = Math.sin(angle) * dist - 80;
          p.style.cssText = `--dx:${dx}px;--dy:${dy}px;--rot:${Math.random()*360}deg;width:${size}px;height:${size}px;background:${color};border-radius:50%;left:50%;top:50%;`;
          coleccion.appendChild(p);
          setTimeout(() => p.remove(), 1200);
        }

        setTimeout(() => {
          guardado.classList.add('show');
          setTimeout(() => {
            sobre.classList.remove('active');
            setTimeout(() => {
              sobre.remove();
              sobreAnimando = false;
              if (despues) despues();
            }, 400);
          }, 800);
        }, 600);
      }

      sobre.addEventListener('click', function(e) {
        if (!animandoGuardar && (e.target === sobre || e.target.id === 'sobre-bg' || e.target.closest('#sobre-contenedor') || e.target.id === 'sobre-tap-texto' || e.target.id === 'sobre-mensaje')) {
          guardarSobre();
        }
      });
    }
    function actualizarReloj() {
      const ahora = new Date();
      const fechaStr = ahora.toLocaleDateString('es-CL', { weekday: 'long', day: 'numeric', month: 'long' });
      const horaStr = ahora.toLocaleTimeString('es-CL', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
      const parpadeo = ahora.getSeconds() % 2 === 0 ? '1' : '0.5';
      document.getElementById('reloj').innerHTML = fechaStr.toUpperCase() + ' <span style="opacity:' + parpadeo + ';">⏳</span> ' + horaStr;
      const ssTime = document.getElementById('slideshow-time');
      const ssDate = document.getElementById('slideshow-date');
      if (ssTime && ssDate) { ssTime.innerText = horaStr; ssDate.innerText = fechaStr.toUpperCase(); }
    }
    setInterval(actualizarReloj, 1000);
    let pollTimer = null;
    function actualizarUI(data) {
      let porcentaje = data.total_tareas > 0 ? Math.round((data.aprobadas.length / data.total_tareas) * 100) : 0;
      document.getElementById('xpFill').style.width = Math.min(porcentaje, 100) + '%';
      document.getElementById('porcentajeTxt').innerText = porcentaje + '%';
      document.getElementById('faltaPorcentajeTxt').innerText = 'Faltan ' + (100 - porcentaje > 0 ? 100 - porcentaje : 0) + '%';
      document.getElementById('tiempoTxt').innerText = data.tiempo_formato;
      document.getElementById('tareasTxt').innerText = 'MISIONES: ' + data.aprobadas.length + ' / ' + data.total_tareas;
    }
    function cargarEstadoInicial() {
      fetch('/api/estado').then(res => res.json()).then(data => {
        actualizarUI(data);
        if (data.total_tareas > 0 && data.aprobadas.length === data.total_tareas) {
          finalActivo = true;
          document.body.classList.add('victory-mode');
          const horaFin = new Date().toLocaleTimeString('es-CL');
          const listaTareas = data.aprobadas.map(t => '<span class="victory-task-item">' + t + '</span>').join('');
          document.getElementById('contenido').innerHTML = "<div class='status victory-card' style='width:100%;'>"
            + "<h2>🏆 META FINAL!</h2>"
            + "<p class='victory-count'>" + data.total_tareas + "/" + data.total_tareas + " MISIONES LOGRADAS</p>"
            + "<div class='victory-stats'>"
            + "<span>⏱ " + data.tiempo_formato + "</span>"
            + "<span>🕐 " + horaFin + "</span>"
            + "</div>"
            + "<div class='victory-tasks'>" + listaTareas + "</div>"
            + "</div>";
          setInterval(spawnConfetti, 300);
          setInterval(spawnFirework, 1500);
          return;
        }
        data.aprobadas.forEach(tarea => {
          const btn = document.querySelector('[data-nombre="' + tarea + '"]');
          if (btn && !btn.disabled) btn.disabled = true;
        });
      }).catch(() => {});
    }
    window.enviarMision = function(tarea) {
      aClic.currentTime = 0; aClic.play().catch(() => {});
      document.body.classList.remove('fail-mode');
      document.getElementById('contenido').innerHTML = "<div class='status waiting-status'><div class='spinner'></div><p>Solicitando Aprobación</p></div>";
      ultimoEstadoProcesado = 'enviada';
      fetch('/api/mandar?tarea=' + encodeURIComponent(tarea));
      if (pollTimer) clearInterval(pollTimer);
      pollTimer = setInterval(pollEstadoEsperando, 2000);
    }
    window.volverAlMenu = function() {
      if (pollTimer) clearInterval(pollTimer);
      pollTimer = null;
      mostrarSobreMundial(function() { location.reload(); });
    }
    window.reintentarTarea = function() {
      if (pollTimer) clearInterval(pollTimer);
      pollTimer = null;
      fetch('/api/reintentar').then(() => { location.reload(); });
    }
    function detenerPoll() {
      if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
    }
    function pollEstadoEsperando() {
      fetch('/api/estado').then(res => res.json()).then(data => {
        actualizarUI(data);
        data.aprobadas.forEach(tarea => {
          const btn = document.querySelector('[data-nombre="' + tarea + '"]');
          if (btn && !btn.disabled) btn.disabled = true;
        });
        procesarEstado(data);
      }).catch(() => {});
    }
    function procesarEstado(data) {
      if (data.valor === 'aprobada' && ultimoEstadoProcesado !== 'aprobada') {
        detenerPoll();
        ultimoEstadoProcesado = 'aprobada'; aMoneda.play();
        document.body.classList.remove('fail-mode');
        if (data.total_tareas > 0 && data.aprobadas.length === data.total_tareas) {
          if (!finalActivo) {
            finalActivo = true;
            document.body.classList.add('victory-mode');
            const horaFin = new Date().toLocaleTimeString('es-CL');
            const listaTareas = data.aprobadas.map(t => '<span class="victory-task-item">' + t + '</span>').join('');
            document.getElementById('contenido').innerHTML = "<div class='status victory-card' style='width:100%;'>"
              + "<h2>🏆 META FINAL!</h2>"
              + "<p class='victory-count'>" + data.total_tareas + "/" + data.total_tareas + " MISIONES LOGRADAS</p>"
              + "<div class='victory-stats'>"
              + "<span>⏱ " + data.tiempo_formato + "</span>"
              + "<span>🕐 " + horaFin + "</span>"
              + "</div>"
              + "<div class='victory-tasks'>" + listaTareas + "</div>"
              + "</div>";
            setInterval(spawnConfetti, 300);
            setInterval(spawnFirework, 1500);
          }
        } else {
          document.getElementById('contenido').innerHTML = "<div style='display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;height:100%;grid-column:1/-1;'><div class='status' style='padding:24px;text-align:center;border:2px solid var(--color-emerald);border-radius:var(--radius);background:var(--color-surface);width:100%;'><p style='color:var(--color-emerald);font-size:1.3rem;font-weight:700;font-family:var(--font-display);'>LEVEL UP!</p><p style='color:var(--color-text);margin-top:8px;'>Misión cumplida</p></div><button onclick='volverAlMenu()' class='btn' style='width:auto;min-width:200px;'><span class='btn-icon'>🔄</span> VOLVER</button></div>";
        }
      } else if (data.valor === 'rechazada' && ultimoEstadoProcesado !== 'rechazada') {
        detenerPoll();
        ultimoEstadoProcesado = 'rechazada'; aError.play();
        document.body.classList.add('fail-mode');
        document.getElementById('contenido').innerHTML = "<div style='display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;height:100%;grid-column:1/-1;'><div class='status' style='padding:24px;text-align:center;border:2px solid var(--color-rose);border-radius:var(--radius);background:rgba(244,63,94,0.1);width:100%;'><p style='color:var(--color-rose);font-size:1.1rem;font-family:var(--font-display);'>RECHAZADO</p></div><button onclick='reintentarTarea()' class='btn' style='width:auto;min-width:200px;'><span class='btn-icon'>🏹</span> REINTENTAR</button></div>";
      }
    }
    (function esperarTema() {
      if (window.themeListo) {
        cargarEstadoInicial();
        if (new URLSearchParams(location.search).has('test_sobre')) {
          setTimeout(function() { mostrarSobreMundial(); }, 1200);
        }
      }
      else setTimeout(esperarTema, 30);
    })();
    let timeoutInactivity, slideshowInterval;
    const TIME_INACTIVITY = 60000;
    let isSlideshowActive = false, imagesList = [], orientationCache = {}, playlist = [], currentSlideIndex = 0;

    function resetInactivityTimer() {
      if (isSlideshowActive) hideSlideshow();
      clearTimeout(timeoutInactivity);
      timeoutInactivity = setTimeout(startSlideshow, TIME_INACTIVITY);
    }

    function hideSlideshow() {
      isSlideshowActive = false;
      const c = document.getElementById('slideshow-container');
      c.classList.remove('active');
      setTimeout(() => { if (!isSlideshowActive) c.style.display = 'none'; }, 1000);
      clearInterval(slideshowInterval);
    }

    function checkOrientation(src) {
      return new Promise(resolve => {
        if (orientationCache[src] !== undefined) {
          resolve(orientationCache[src]);
          return;
        }
        const img = new Image();
        img.onload = () => {
          orientationCache[src] = img.naturalHeight > img.naturalWidth ? 'portrait' : 'landscape';
          resolve(orientationCache[src]);
        };
        img.onerror = () => {
          orientationCache[src] = 'landscape';
          resolve('landscape');
        };
        img.src = src;
      });
    }

    function buildPlaylist(images) {
      return Promise.all(images.map(src => checkOrientation(src)))
        .then(() => {
          const isPortraitOrientation = window.innerHeight > window.innerWidth;
          const pl = [];

          if (isPortraitOrientation) {
            for (const src of images) {
              pl.push({ type: 'single', src });
            }
          } else {
            const portraits = images.filter(src => orientationCache[src] === 'portrait');
            const landscapes = images.filter(src => orientationCache[src] === 'landscape');

            for (let i = 0; i < portraits.length - 1; i += 2) {
              pl.push({ type: 'pair', src: [portraits[i], portraits[i+1]] });
            }

            if (portraits.length % 2 !== 0) {
              const last = portraits[portraits.length - 1];
              if (landscapes.length > 0) {
                pl.push({ type: 'pair', src: [last, landscapes.shift()] });
              } else {
                pl.push({ type: 'single', src: last });
              }
            }

            for (const src of landscapes) {
              pl.push({ type: 'single', src });
            }
          }

          return pl;
        });
    }

    function showSlide(index) {
      const slide = playlist[index];
      const singleEl = document.getElementById('slideshow-img');
      const pairEl = document.getElementById('slideshow-pair');

      if (slide.type === 'single') {
        singleEl.src = slide.src;
        singleEl.style.display = 'block';
        pairEl.style.display = 'none';
      } else {
        document.getElementById('slideshow-img1').src = slide.src[0];
        document.getElementById('slideshow-img2').src = slide.src[1];
        singleEl.style.display = 'none';
        pairEl.style.display = 'flex';
      }
    }

    function startSlideshow() {
      fetch('/api/slideshow-images').then(res => res.json()).then(data => {
        if (data.images && data.images.length > 0) {
          imagesList = data.images;
          orientationCache = {};
          return buildPlaylist(imagesList);
        }
      }).then(pl => {
        if (!pl || pl.length === 0) return;
        playlist = pl;
        currentSlideIndex = 0;
        showSlide(0);
        const c = document.getElementById('slideshow-container');
        c.style.display = 'block'; void c.offsetWidth; c.classList.add('active');
        isSlideshowActive = true;
        slideshowInterval = setInterval(() => {
          const content = document.getElementById('slideshow-content');
          content.classList.add('fade-out');
          setTimeout(() => {
            currentSlideIndex = (currentSlideIndex + 1) % playlist.length;
            showSlide(currentSlideIndex);
            content.classList.remove('fade-out');
          }, 1500);
        }, 60000);
      }).catch(() => {});
    }
    function onUserInteraction(ev) {
      if (isSlideshowActive) {
        hideSlideshow();
        ev.stopPropagation();
        return;
      }
      clearTimeout(timeoutInactivity);
      timeoutInactivity = setTimeout(startSlideshow, TIME_INACTIVITY);
    }

    ['mousemove', 'mousedown', 'keypress', 'touchstart', 'scroll'].forEach(e => {
      document.addEventListener(e, onUserInteraction, true);
    });
    resetInactivityTimer();
  </script>

  <style>
    .clock-display {
      font-family: var(--font-display);
      font-size: clamp(19px, 2dvh, 20px);
      color: var(--primary);
      text-align: center;
      margin-bottom: clamp(6px, 1dvh, 16px);
      letter-spacing: 1px;
      text-shadow: 0 0 20px rgba(251, 191, 36, 0.1);
    }
    .status {
      animation: fadeIn 0.4s ease forwards;
      padding: clamp(14px, 3dvh, 32px) !important;
    }
    .status h2 {
      font-size: clamp(19px, 2.5dvh, 26px) !important;
    }
    .status p {
      font-size: clamp(19px, 2.2dvh, 24px) !important;
    }
    @keyframes confetti-fall {
      0% { transform: translateY(0) rotate(0deg); opacity: 1; }
      100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
    }
    @keyframes firework-burst {
      0% { transform: translate(0,0) scale(1); opacity: 1; }
      100% { transform: translate(var(--dx),var(--dy)) scale(0); opacity: 0; }
    }
    .task-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(4px, 0.6dvh, 8px);
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      align-content: start;
    }
    @media (orientation: portrait) and (max-width: 650px) {
      .task-grid {
        grid-template-columns: 1fr;
        gap: clamp(6px, 1dvh, 10px);
      }
    }
    .empty-msg {
      text-align: center;
      padding: clamp(16px, 3dvh, 40px) clamp(16px, 3vw, 28px);
      color: var(--color-text-dim);
      font-family: var(--font-body);
      font-size: clamp(14px, 1.8dvh, 18px);
    }
    .empty-msg .btn {
      display: inline-flex;
      width: auto;
      margin-top: clamp(10px, 1.5dvh, 20px);
      font-size: clamp(13px, 1.6dvh, 18px);
      padding: clamp(10px, 1.5dvh, 16px) clamp(18px, 2.5dvh, 28px);
    }
    body.fail-mode .card {
      border-color: var(--color-rose);
      box-shadow: 0 0 30px rgba(244, 63, 94, 0.2);
    }
    body.fail-mode .card::after {
      background: linear-gradient(90deg, transparent, var(--color-rose), transparent);
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>

  <style is:global>
    body.victory-mode .task-grid {
      display: flex;
      justify-content: center;
      height: 100%;
    }
    body.victory-mode .card {
      border-color: var(--color-gold);
      animation: victory-glow 1.5s ease-in-out infinite;
    }
    body.victory-mode .card::after {
      background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
    }
    .victory-card {
      padding: clamp(16px, 3dvh, 28px);
      text-align: center;
      border-radius: var(--radius);
      background: var(--color-surface);
      width: 100%;
      height: auto;
      animation: fadeIn 0.4s ease forwards;
    }
    .victory-card h2 {
      color: var(--color-gold);
      font-family: var(--font-display);
      font-size: clamp(1.2rem, 2.5dvh, 1.6rem);
      margin-bottom: 4px;
    }
    .victory-count {
      color: var(--color-emerald);
      font-size: clamp(1rem, 2dvh, 1.3rem);
      font-weight: 600;
      margin-bottom: 4px;
    }
    .victory-stats {
      display: flex;
      gap: 16px;
      justify-content: center;
      color: var(--color-text);
      font-size: clamp(0.75rem, 1.4dvh, 0.95rem);
      margin-top: 6px;
    }
    .victory-tasks {
      
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2px 24px;
      margin-top: 8px;
      font-size: clamp(1rem, 1.3dvh, 0.9rem);
      text-align: center;
    }
    .victory-task-item::before {
      content: '- ';
    }
    .waiting-status {
      grid-column: 1 / -1;
      padding: 32px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 24px;
      min-height: 200px;
    }
    .waiting-status p {
      font-family: var(--font-display);
      font-size: clamp(1.2rem, 2.2dvh, 1.6rem);
    }
