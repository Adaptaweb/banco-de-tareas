---
const currentPath = Astro.url.pathname;
---

<div class="hamburger-wrap">
  <button class="hamburger-btn" id="hamBtn" aria-label="Abrir menú">
    <span class="ham-line"></span>
    <span class="ham-line"></span>
    <span class="ham-line"></span>
  </button>

  <div class="ham-overlay" id="hamOverlay"></div>

  <nav class="ham-drawer" id="hamDrawer">
    <div class="ham-drawer-header">
      <span class="ham-drawer-title">Menú</span>
      <button class="ham-drawer-close" id="hamClose" aria-label="Cerrar menú">✕</button>
    </div>
    <div class="ham-drawer-links">
      <a href="/" class="ham-link{currentPath === '/' ? ' active' : ''}">
        <span class="ham-link-icon">🏠</span>
        Inicio
      </a>
      <a href="/admin" class="ham-link{currentPath === '/admin' ? ' active' : ''}">
        <span class="ham-link-icon">⚙️</span>
        Panel de Administración
      </a>
      <a href="/historial" class="ham-link{currentPath === '/historial' ? ' active' : ''}">
        <span class="ham-link-icon">📜</span>
        Historial
      </a>
    </div>
  </nav>
</div>

<script>
  const btn = document.getElementById('hamBtn');
  const drawer = document.getElementById('hamDrawer');
  const overlay = document.getElementById('hamOverlay');
  const closeBtn = document.getElementById('hamClose');

  function openMenu() {
    btn.classList.add('active');
    drawer.classList.add('active');
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
    const aClic = document.getElementById('audioClic');
    if (aClic) { aClic.currentTime = 0; aClic.play().catch(() => {}); }
  }

  function closeMenu() {
    btn.classList.remove('active');
    drawer.classList.remove('active');
    overlay.classList.remove('active');
    document.body.style.overflow = '';
  }

  btn.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', closeMenu);
  overlay.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer.classList.contains('active')) closeMenu();
  });

  drawer.querySelectorAll('.ham-link').forEach(a => {
    a.addEventListener('click', () => {
      closeMenu();
    });
  });
</script>

<style>
  .hamburger-wrap {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 200;
  }

  .hamburger-btn {
    position: fixed;
    top: clamp(8px, 1.5dvh, 16px);
    left: clamp(8px, 1.5dvw, 16px);
    z-index: 210;
    width: clamp(36px, 4dvh, 44px);
    height: clamp(36px, 4dvh, 44px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(3px, 0.4dvh, 6px);
    cursor: pointer;
    padding: clamp(6px, 0.7dvh, 10px);
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    transition: border-color 0.2s, background 0.2s;
  }

  .hamburger-btn:hover {
    border-color: var(--color-gold-dim);
  }

  .hamburger-btn.active {
    border-color: var(--color-gold);
  }

  .ham-line {
    display: block;
    width: clamp(18px, 2.5dvh, 24px);
    height: 3px;
    background: var(--color-text);
    border-radius: 0;
    transition: all 0.3s ease;
    transform-origin: center;
  }

  .hamburger-btn.active .ham-line:nth-child(1) {
    transform: translateY(clamp(6px, 0.8dvh, 8px)) rotate(45deg);
  }

  .hamburger-btn.active .ham-line:nth-child(2) {
    opacity: 0;
  }

  .hamburger-btn.active .ham-line:nth-child(3) {
    transform: translateY(clamp(-6px, -0.8dvh, -8px)) rotate(-45deg);
  }

  .ham-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    z-index: 190;
  }

  .ham-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .ham-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(280px, 80dvw);
    background: var(--color-surface);
    border-right: 2px solid var(--color-border);
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 200;
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.5);
  }

  .ham-drawer.active {
    transform: translateX(0);
  }

  .ham-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: clamp(14px, 2dvh, 22px) clamp(12px, 1.8dvh, 18px) clamp(8px, 1dvh, 14px);
    border-bottom: 2px solid var(--color-border);
  }

  .ham-drawer-title {
    font-family: var(--font-display);
    font-size: clamp(10px, 1.2dvh, 14px);
    color: var(--color-gold);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .ham-drawer-close {
    background: none;
    border: none;
    color: var(--color-text-dim);
    font-size: clamp(16px, 2dvh, 22px);
    cursor: pointer;
    padding: 4px 8px;
    font-family: var(--font-body);
    line-height: 1;
    transition: color 0.2s;
  }

  .ham-drawer-close:hover {
    color: var(--color-rose);
  }

  .ham-drawer-links {
    flex: 1;
    padding: clamp(10px, 1.5dvh, 20px);
    display: flex;
    flex-direction: column;
    gap: clamp(3px, 0.4dvh, 6px);
    min-width: 0;
  }

  .ham-link {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.2dvh, 14px);
    padding: clamp(10px, 1.4dvh, 16px) clamp(12px, 1.6dvh, 18px);
    font-family: var(--font-body);
    font-size: clamp(11px, 1.4dvh, 15px);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid transparent;
    border-left: 3px solid transparent;
    transition: all 0.2s;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .ham-link:hover {
    background: var(--color-surface-raised);
    border-color: var(--color-gold-dim);
    border-left-color: var(--color-gold-dim);
    color: var(--color-gold);
  }

  .ham-link.active {
    background: var(--color-surface-raised);
    border-color: var(--color-gold-dim);
    border-left-color: var(--color-gold);
    color: var(--color-gold);
    box-shadow: inset 3px 0 0 var(--color-gold);
    position: relative;
  }

  .ham-link.active::after {
    content: '▶';
    position: absolute;
    right: clamp(8px, 1dvh, 14px);
    font-size: clamp(8px, 0.9dvh, 11px);
    color: var(--color-gold);
  }

  .ham-link-icon {
    font-size: clamp(16px, 2dvh, 22px);
    width: clamp(22px, 3dvh, 30px);
    text-align: center;
    flex-shrink: 0;
  }

  :global(body.theme-mario) .hamburger-btn {
    border-radius: var(--radius-sm);
  }

  :global(body.theme-mario) .ham-line {
    border-radius: 2px;
  }

  :global(body.theme-mario) .ham-drawer {
    border-radius: 0 var(--radius) 0 0;
    background: rgba(200, 30, 30, 0.92);
  }

  :global(body.theme-mario) .ham-link {
    border-radius: var(--radius-sm);
  }

  :global(body.theme-mario) .ham-link.active::after {
    color: var(--color-gold);
  }
</style>
