---
export interface Props {
  total_tareas: number;
  aprobadas: number;
  tiempo_formato: string;
}

const { total_tareas, aprobadas, tiempo_formato } = Astro.props;
const porcentaje = total_tareas > 0 ? Math.round((aprobadas / total_tareas) * 100) : 0;
---

<div class="xp-container">
  <div class="xp-header">
    <span class="xp-label">Progreso</span>
    <span id="tareasTxt" class="xp-count">{aprobadas}/{total_tareas}</span>
  </div>
  <div class="xp-bar-bg">
    <div id="xpFill" class="xp-bar-fill" style={`width: ${Math.min(porcentaje, 100)}%`}></div>
  </div>
  <div class="xp-info">
    <span id="porcentajeTxt">{porcentaje}%</span>
    <span id="faltaPorcentajeTxt">Faltan {100 - porcentaje}%</span>
  </div>
  <div class="xp-level" id="tiempoTxt">{tiempo_formato}</div>
</div>

<style>
  .xp-container {
    width: 100%;
    margin-bottom: 16px;
    position: relative;
    z-index: 1;
  }

  .xp-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .xp-label {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-text-dim);
    letter-spacing: 2px;
  }

  .xp-count {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-text-dim);
  }

  .xp-bar-bg {
    background: #0a0a0a;
    height: 16px;
    border: 2px solid #1e1e1f;
    position: relative;
    overflow: hidden;
    box-shadow:
      inset 1px 1px 0 rgba(255, 255, 255, 0.08),
      inset -1px -1px 0 rgba(0, 0, 0, 0.3);
  }

  .xp-bar-fill {
    background: linear-gradient(180deg, #7dff7d, #55ff55 40%, #00aa00);
    height: 100%;
    width: 0%;
    transition: width 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 0 8px rgba(85, 255, 85, 0.4);
    position: relative;
  }

  .xp-bar-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.2) 50%,
      transparent 100%
    );
    background-size: 200% 100%;
    animation: shimmer 2s ease-in-out infinite;
  }

  .xp-info {
    display: flex;
    justify-content: space-between;
    font-size: 1.2rem;
    font-family: var(--font-display);
    color: var(--color-emerald);
    margin-top: 6px;
  }

  .xp-level {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-gold);
    text-align: center;
    margin-top: 8px;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.5);
  }

  @keyframes shimmer {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }
</style>
