{
  "name": "banco-de-tareas",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "concurrently \"node dist/telegram-bot.js\" \"node dist/server/entry.mjs\"",
    "start:bot": "node dist/telegram-bot.js",
    "start:web": "node dist/server/entry.mjs",
    "dev:all": "concurrently -n WEB,BOT -c blue,green \"npm:dev\" \"tsx src/telegram-bot.ts\""
  },
  "dependencies": {
    "@astrojs/node": "^9.2.0",
    "astro": "^5.7.0",
    "better-sqlite3": "^11.9.0",
    "concurrently": "^9.1.0",
    "dotenv": "^16.6.1",
    "sweetalert2": "^11.26.25",
    "telegraf": "^4.16.3",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0"
  }
}
